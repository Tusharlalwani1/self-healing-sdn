  "components": {
    "schemas": {
      "ControllerSelectRequest": {
        "properties": {
          "controller_type": {
            "type": "string",
            "title": "Controller Type",
            "description": "baseline, reactive, or fast_failover"
          }
        },
        "type": "object",
        "required": [
          "controller_type"
        ],
        "title": "ControllerSelectRequest"
      },
      "ExperimentRunRequest": {
        "properties": {
          "controller": {
            "type": "string",
            "title": "Controller",
            "default": "reactive"
          },
          "traffic_interval": {
            "type": "number",
            "title": "Traffic Interval",
            "default": 0.02
          },
          "packet_count": {
            "type": "integer",
            "title": "Packet Count",
            "default": 300
          },
          "failure_delay_sec": {
            "type": "number",
            "title": "Failure Delay Sec",
            "default": 2.0
          },
          "fail_link_src": {
            "type": "string",
            "title": "Fail Link Src",
            "default": "s1"
          },
          "fail_link_dst": {
            "type": "string",
            "title": "Fail Link Dst",
            "default": "s2"
          },
          "repetitions": {
            "type": "integer",
            "title": "Repetitions",
            "default": 1
          }
        },
        "type": "object",
        "title": "ExperimentRunRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkActionRequest": {
        "properties": {
          "node1": {
            "type": "string",
            "title": "Node1"
          },
          "node2": {
            "type": "string",
            "title": "Node2"
          }
        },
        "type": "object",
        "required": [
          "node1",
          "node2"
        ],
        "title": "LinkActionRequest"
      },
      "SimulationStartRequest": {
        "properties": {
          "controller_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller Type",
            "default": "reactive"
          }
        },
        "type": "object",
        "title": "SimulationStartRequest"
      },
      "TrafficStartRequest": {
        "properties": {
          "src": {
            "type": "string",
            "title": "Src",
            "default": "h1"
          },
          "dst": {
            "type": "string",
            "title": "Dst",
            "default": "h2"
          },
          "interval": {
            "type": "number",
            "title": "Interval",
            "default": 0.05
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 200
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          }
        },
        "type": "object",
        "title": "TrafficStartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}